# Market Morning product UI stays absent from navigation unless explicitly enabled.
VITE_MARKET_MORNING_ENABLED=false
# Local browser demo only. The Vite plugin refuses to enable it in any mode
# other than development and labels all research content as synthetic fixture.
VITE_MARKET_MORNING_DEMO=false

# Select the built-in production SPA adapter. Leave blank for local development
# with an explicitly registered test/deployment adapter. These values are public
# SPA identifiers, never client secrets.
VITE_MARKET_MORNING_AUTH_PROVIDER=
VITE_MARKET_MORNING_AUTH0_DOMAIN=
VITE_MARKET_MORNING_AUTH0_AUDIENCE=
VITE_MARKET_MORNING_AUTH0_PRODUCT_CLIENT_ID=
VITE_MARKET_MORNING_AUTH0_OPERATOR_CLIENT_ID=

# When Auth0 is selected, configure both SPA applications with these exact URLs:
# Allowed Callback URLs: https://YOUR_APP_ORIGIN/market-morning, https://YOUR_APP_ORIGIN/market-morning-ops
# Allowed Logout URLs:   https://YOUR_APP_ORIGIN/
# Allowed Web Origins:   https://YOUR_APP_ORIGIN

# Existing Vite development proxy target.
VITE_API_URL=http://127.0.0.1:8899
